<odoo>
    <!-- ===================================================== AI Presets -->
    <record id="view_sgc_ai_preset_list" model="ir.ui.view">
        <field name="name">sgc.ai.preset.list</field>
        <field name="model">sgc.ai.preset</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="mode"/>
                <field name="run_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_ai_preset_form" model="ir.ui.view">
        <field name="name">sgc.ai.preset.form</field>
        <field name="model">sgc.ai.preset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="mode"/>
                            <field name="intent"/>
                            <field name="provider"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="accent"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="run_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="kpi_codes"/>
                        <field name="prompt_template"/>
                        <field name="spec_json"/>
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sgc_ai_preset" model="ir.actions.act_window">
        <field name="name">AI Presets</field>
        <field name="res_model">sgc.ai.preset</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================================================= KPI Definitions -->
    <record id="view_sgc_kpi_definition_list" model="ir.ui.view">
        <field name="name">sgc.kpi.definition.list</field>
        <field name="model">sgc.kpi.definition</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="model_name"/>
                <field name="aggregate"/>
                <field name="source"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_kpi_definition_form" model="ir.ui.view">
        <field name="name">sgc.kpi.definition.form</field>
        <field name="model">sgc.kpi.definition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="model_name"/>
                            <field name="aggregate"/>
                            <field name="measure_field"/>
                            <field name="date_field"/>
                            <field name="group_field"/>
                        </group>
                        <group>
                            <field name="viz"/>
                            <field name="value_format"/>
                            <field name="accent"/>
                            <field name="icon"/>
                            <field name="limit"/>
                            <field name="source"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="domain_json"/>
                        <field name="description"/>
                        <field name="created_by_prompt" readonly="1"/>
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sgc_kpi_definition" model="ir.actions.act_window">
        <field name="name">KPI Definitions</field>
        <field name="res_model">sgc.kpi.definition</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ======================================================= AI Jobs -->
    <record id="view_sgc_ai_job_list" model="ir.ui.view">
        <field name="name">sgc.ai.job.list</field>
        <field name="model">sgc.ai.job</field>
        <field name="arch" type="xml">
            <list default_order="id desc" create="false">
                <field name="id"/>
                <field name="preset_id"/>
                <field name="prompt"/>
                <field name="period"/>
                <field name="state" widget="badge"/>
                <field name="user_id"/>
                <field name="started_at"/>
                <field name="ended_at"/>
            </list>
        </field>
    </record>

    <record id="action_sgc_ai_job" model="ir.actions.act_window">
        <field name="name">AI Jobs</field>
        <field name="res_model">sgc.ai.job</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ========================================================= Menus -->
    <menuitem id="menu_sgc_ai_admin"
              name="AI Command Layer"
              parent="menu_sgc_executive_root"
              groups="sgc_executive_dashboard.group_sgc_executive_officer"
              sequence="20"/>

    <menuitem id="menu_sgc_ai_preset"
              name="Presets"
              parent="menu_sgc_ai_admin"
              action="action_sgc_ai_preset"
              sequence="10"/>

    <menuitem id="menu_sgc_kpi_definition"
              name="KPI Definitions"
              parent="menu_sgc_ai_admin"
              action="action_sgc_kpi_definition"
              sequence="20"/>

    <menuitem id="menu_sgc_ai_job"
              name="Jobs"
              parent="menu_sgc_ai_admin"
              action="action_sgc_ai_job"
              sequence="30"/>
</odoo>
