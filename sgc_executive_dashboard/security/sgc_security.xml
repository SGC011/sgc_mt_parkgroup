<odoo>
    <record id="module_category_sgc_executive" model="ir.module.category">
        <field name="name">SGC Executive</field>
        <field name="description">Access to the SGC Executive Command Center.</field>
        <field name="sequence">1</field>
    </record>

    <record id="privilege_sgc_executive" model="res.groups.privilege">
        <field name="name">SGC Executive</field>
        <field name="category_id" ref="module_category_sgc_executive"/>
    </record>

    <record id="group_sgc_executive_viewer" model="res.groups">
        <field name="name">Executive Viewer</field>
        <field name="privilege_id" ref="privilege_sgc_executive"/>
        <field name="comment">Read-only access to the consolidated executive dashboard.</field>
    </record>

    <record id="group_sgc_executive_officer" model="res.groups">
        <field name="name">Executive Officer</field>
        <field name="privilege_id" ref="privilege_sgc_executive"/>
        <field name="implied_ids" eval="[(4, ref('group_sgc_executive_viewer'))]"/>
        <field name="comment">Full cross-company executive access, including dormant app activation.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_sgc_executive_officer'))]"/>
    </record>
</odoo>
