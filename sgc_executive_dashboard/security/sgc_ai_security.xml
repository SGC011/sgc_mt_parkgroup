<odoo>
    <!-- The real security boundary for AI job visibility: the inline
         check in sgc.ai.job.poll() alone would not stop a raw search()/
         read() on this model from leaking another executive's prompts
         and results. Group-scoped ir.rules on the same model are OR'd,
         so a viewer sees only their own jobs and a system admin sees all. -->
    <record id="rule_sgc_ai_job_own" model="ir.rule">
        <field name="name">SGC AI Job: own records only</field>
        <field name="model_id" ref="model_sgc_ai_job"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sgc_executive_viewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sgc_ai_job_admin" model="ir.rule">
        <field name="name">SGC AI Job: administrators see all</field>
        <field name="model_id" ref="model_sgc_ai_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
